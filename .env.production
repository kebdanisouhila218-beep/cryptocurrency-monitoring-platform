# .env.production - Configuration de production
# ⚠️ NE PAS COMMITER CE FICHIER AVEC DES VRAIES VALEURS
# Copier ce fichier et remplacer les valeurs par vos configurations réelles

# ============================================
# MongoDB
# ============================================
MONGO_HOST=mongodb-prod.example.com
MONGO_PORT=27017
MONGO_URI=mongodb://mongodb-prod.example.com:27017/
DB_NAME=crypto_db

# ============================================
# Redis
# ============================================
REDIS_HOST=redis-prod.example.com
REDIS_PORT=6379
REDIS_URL=redis://redis-prod.example.com:6379/0

# ============================================
# JWT Authentication
# ============================================
# ⚠️ IMPORTANT: Générer une clé secrète unique et longue
# Commande: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGEZ_MOI_EN_PRODUCTION_CLÉ_TRÈS_LONGUE_ET_ALÉATOIRE_64_CARACTERES_MINIMUM
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# Email (SMTP) - Pour les alertes
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@crypto-platform.com
SMTP_FROM_NAME=CryptoTracker

# ============================================
# Discord (Optionnel) - Pour les notifications
# ============================================
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ============================================
# API Configuration
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
DEBUG=false

# ============================================
# Frontend Configuration
# ============================================
REACT_APP_API_URL=https://api.crypto-platform.com
REACT_APP_ENV=production

# ============================================
# CoinPaprika API
# ============================================
COINPAPRIKA_API_URL=https://api.coinpaprika.com/v1

# ============================================
# Monitoring (Optionnel)
# ============================================
# Sentry pour le tracking d'erreurs
SENTRY_DSN=https://your-key@sentry.io/your-project

# ============================================
# Celery (Tâches asynchrones)
# ============================================
CELERY_BROKER_URL=redis://redis-prod.example.com:6379/0
CELERY_RESULT_BACKEND=redis://redis-prod.example.com:6379/0

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# Security
# ============================================
CORS_ORIGINS=https://crypto-platform.com,https://www.crypto-platform.com
ALLOWED_HOSTS=crypto-platform.com,www.crypto-platform.com,api.crypto-platform.com
